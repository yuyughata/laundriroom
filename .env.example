# ─────────────────────────────────────────────────────────────────────────────
# laundriroom — environment variables
# Copy this file to `.env.local` and fill in the values once you connect a
# Supabase project. Nothing here is required to read the code; it is required to
# run the app against a live database.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (client-safe) -------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co  (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe to expose to the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — NEVER expose to the browser) -------------------
# Service-role key. Used only in server code and edge functions for privileged
# operations (payout release, webhooks). Keep it out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=laundriroom

# --- Payments (Paystack) — configured later, from the Admin → Integrations UI
# These are fallbacks for local dev; in production the keys live in Supabase
# Edge Function secrets, not here.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# With no payment key set, "Pay now" simulates a successful payment so you can
# test the flow. That only happens under `npm run dev`; set this to true to
# allow it on a deployed (staging) build too. Never on production.
ALLOW_SIMULATED_PAYMENTS=

# --- Notifications — all optional; the framework runs without them and each
# channel turns on only when its provider is configured in Admin → Integrations
RESEND_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# --- Google Maps (optional) — distance-based delivery fees -------------------
# Server-side key with the Geocoding API and Distance Matrix API enabled. Used
# only when Admin → Fees & charges → Delivery pricing is set to "By distance";
# without it every delivery uses the flat fee. Never exposed to the browser.
GOOGLE_MAPS_API_KEY=
