{
  "name": "laundriroom",
  "version": "0.1.0",
  "private": true,
  "description": "laundriroom — a two-sided laundry service platform (customer app, vendor dashboard, admin dashboard) on Next.js + Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "setup": "node scripts/check-env.mjs",
    "emails:auth": "node scripts/build-auth-emails.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.4",
    "html5-qrcode": "^2.3.8",
    "next": "14.2.35",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
